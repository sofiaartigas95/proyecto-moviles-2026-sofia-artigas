rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /categories/{categoryId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['name'])
        && (
          (categoryId == 'electronica' && request.resource.data.name == 'Electrónica')
          || (categoryId == 'documentos' && request.resource.data.name == 'Documentos')
          || (categoryId == 'ropa_accesorios' && request.resource.data.name == 'Ropa y accesorios')
          || (categoryId == 'llaves' && request.resource.data.name == 'Llaves')
          || (categoryId == 'utiles' && request.resource.data.name == 'Útiles')
          || (categoryId == 'otros' && request.resource.data.name == 'Otros')
        );
    }

    match /items/{itemId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.imageData is bytes;

      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
        && request.resource.data.estado == 'Devuelto';

      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
